{
  "stryker-config": {
    "project": "PenniesCount.Api.csproj",
    "mutate": [
      "**/SavingsDrawdownEndpoints.cs",
      "**/Data/SavingsItem.cs{547..990}",
      "**/SavingsItemEndpoints.cs{513..681}{1120..1249}{2705..2819}{3008..3561}",
      "**/DashboardEndpoints.cs{750..913}{2309..2372}"
    ],
    "test-case-filter": "FullyQualifiedName~SavingsDrawdownScenarios|(FullyQualifiedName~SavingsItemScenarios&FullyQualifiedName!~SavingsCategoryScenarios)|FullyQualifiedName~DashboardScenarios",
    "mutation-level": "Complete",
    "concurrency": 1,
    "ignore-methods": [ "*LogWarning", "*CreateLogger" ],
    "reporters": [ "dots", "cleartext", "html", "json" ],
