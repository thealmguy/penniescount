@inherits ApiPageBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@if (Groups.All(x => x.Items.Length == 0))
{
    <p>No savings items yet. Add your first item to start planning.</p>
}
@foreach (var group in Groups)
{
    var category = Display.SavingsCategoryName(group.Type);
    <section class="mb-4" aria-label="@(group.Type == SavingsTerm.Past ? category : $"{category} savings")">
        <h2>@category</h2>
        @if (group.Items.Length == 0)
        {
            <p>@(group.Type == SavingsTerm.Past ? "No past savings goals." : $"No {category.ToLowerInvariant()} items.")</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>Item</th><th>Target</th><th>Funded allocation</th><th>Drawn down</th><th>Available to spend</th><th>Funding remaining</th><th>Start</th><th>Save by</th><th>Required contribution</th><th>Status</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var row in group.Items)
                        {
                            var item = row.Item;
                            <tr @key="item.Id">
                                <td>@item.Name</td><td>@Display.Money(item.TargetAmount)</td>
                                <td>@Display.Money(item.AllocatedAmount)</td><td>@Display.Money(item.DrawnDownAmount)</td>
                                <td>@Display.Money(item.AvailableAmount)</td><td>@Display.Money(row.RemainingAmount)</td>
                                <td>@item.StartDate.ToString("dd MMM yyyy")</td><td>@item.TargetDate.ToString("dd MMM yyyy")</td>
                                <td>@Display.Money(row.RequiredContribution)</td>
                                <td>
                                    <span class="@(row.Status == ContributionState.NeededNow ? "badge text-bg-warning" : "")">@Display.ContributionName(row.Status)</span>
                                    @if (row.Status == ContributionState.Scheduled)
                                    {
                                        <small class="d-block">@row.RemainingPayments payment(s) remaining</small>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="() => Select(item)">Update allocation</button>
                                    <a href="@($"savings-items/{item.Id}")" class="d-block">Details / draw down</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
<dialog @ref="_dialog" class="allocation-modal" aria-labelledby="allocation-title" @onkeydown="HandleKeyDownAsync">
    @if (_selected is not null)
    {
        <h2 id="allocation-title">Allocation for @_selected.Name</h2>
        <p>This is total funding to date, including money already drawn down, not an account transfer.</p>
        @if (Error is not null)
        {
            <div class="alert alert-danger" role="alert">@Error</div>
            <p>If the record changed, cancel this edit, refresh the budget, then select the item again to reload its latest allocation.</p>
        }
        <EditForm Model="_allocation" OnValidSubmit="SaveAsync" FormName="allocation">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@Busy">
                <label for="allocated-total" class="form-label">Total funding to date (GBP), from @Display.Money(_selected.DrawnDownAmount) to @Display.Money(_selected.TargetAmount)</label>
                <InputNumber id="allocated-total" class="form-control" @bind-Value="_allocation.AllocatedAmount" step="0.01" autofocus />
                <button type="submit" class="btn btn-primary mt-2">Save allocation</button>
                <button type="button" class="btn btn-secondary mt-2" @onclick="CloseAsync">Cancel</button>
            </fieldset>
        </EditForm>
    }
</dialog>

@code {
    [Parameter, EditorRequired] public SavingsGroupResponse[] Groups { get; set; } = [];
    [Parameter] public EventCallback OnSaved { get; set; }
    private SavingsItemResponse? _selected;
    private UpdateAllocationRequest _allocation = new();
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _openRequested;

    private void Select(SavingsItemResponse item)
    {
        ClearError();
        _selected = item;
        _allocation = new() { AllocatedAmount = item.AllocatedAmount, Version = item.Version };
        _openRequested = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_openRequested) return;
        _openRequested = false;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./Components/SavingsItemsList.razor.js");
        await _module.InvokeVoidAsync("show", _dialog);
    }

    private async Task CloseAsync()
    {
        if (Busy) return;
        if (_module is not null) await _module.InvokeVoidAsync("close", _dialog);
        _selected = null;
        ClearError();
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseAsync() : Task.CompletedTask;

    private async Task SaveAsync()
    {
        if (_selected is null) return;
        if (await PerformAsync(async () => await Api.UpdateAllocationAsync(_selected.Id, _allocation)))
        {
            await CloseAsync();
            await OnSaved.InvokeAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null) return;
        try { await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
