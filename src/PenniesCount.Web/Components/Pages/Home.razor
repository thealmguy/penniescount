@page "/"

@rendermode InteractiveServer
@inherits ApiPageBase

<PageTitle>Savings budget</PageTitle>

<h1>Savings budget</h1>
<p>Plan what your savings are for.</p>
<a class="btn btn-primary mb-3" href="savings-items/new">Add savings item</a>
<button class="btn btn-outline-secondary mb-3" disabled="@Busy" @onclick="LoadAsync">Refresh budget</button>
@if (Error is not null)
{
    <div class="alert alert-danger" role="alert">@Error</div>
}
@if (_items is not null)
{
    <p>Budget date: @_items.AsOfDate.ToString("dd MMM yyyy")</p>
    <SavingsItemsList Items="_items.Items" OnSaved="LoadAsync" />
}
else
{
    <p>@(Busy ? "Loading budget..." : "Budget has not loaded. Retry with Refresh budget.")</p>
}

@code {
    private SavingsItemsResponse? _items;
    protected override Task OnInitializedAsync() => LoadAsync();
    private async Task LoadAsync() => await PerformAsync(async () => _items = await Api.GetItemsAsync());
}
