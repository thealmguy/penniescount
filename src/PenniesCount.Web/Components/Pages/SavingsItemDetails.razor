@page "/savings-items/{Id:guid}"
@rendermode InteractiveServer
@inherits ApiPageBase

<PageTitle>Savings item history</PageTitle>
<h1>Savings item history</h1>
<a href="savings-items">Back to savings items</a>
<button class="btn btn-outline-secondary ms-2" disabled="@(Locked)" @onclick="LoadAsync">Refresh item</button>
@if (Error is not null)
{
    <div class="alert alert-danger mt-3" role="alert">@Error</div>
    <p>Displayed figures are from the last successful refresh. If the item changed, cancel the edit and refresh before retrying.</p>
}
@if (_ledger is not null)
{
    var item = _ledger.Item;
    <h2>@item.Name</h2>
    @if (item.IsRemoved)
    {
        <p role="status">Removed - read-only. This item no longer contributes to budget totals.</p>
    }
    <dl>
        <dt>Original target</dt><dd id="item-target">@Display.Money(item.TargetAmount)</dd>
        <dt>Total funded allocation (including drawdowns)</dt><dd id="item-funded">@Display.Money(item.AllocatedAmount)</dd>
        <dt>Drawn down</dt><dd id="item-drawn">@Display.Money(item.DrawnDownAmount)</dd>
        <dt>Available to spend</dt><dd id="item-available">@Display.Money(item.AvailableAmount)</dd>
    </dl>
    <p>This item works like a sub-account: every allocation payment, drawdown and correction is kept in its history.
        Entries are never edited or deleted; mistakes are reversed with an offsetting entry.
        Payments and drawdowns do not move money or change account totals. Update account balances manually when you move the money.</p>
    @if (!item.IsRemoved)
    {
        <button id="add-payment" class="btn btn-primary" disabled="@(Locked || item.AllocatedAmount >= item.TargetAmount)" @onclick="StartPayment">Record allocation payment</button>
        <button id="add-drawdown" class="btn btn-primary" disabled="@(Locked || item.AvailableAmount == 0)" @onclick="() => Edit(null)">Record drawdown</button>
        <button id="remove-item" class="btn btn-outline-danger" disabled="@(Locked)" @onclick="ConfirmRemoval">Mark removed</button>
    }
    @if (_payment is not null)
    {
        <h3>Record allocation payment</h3>
        <EditForm Model="_payment" OnValidSubmit="SavePaymentAsync" FormName="payment">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@Busy">
                <label for="payment-amount">Amount (GBP)</label>
                <InputNumber id="payment-amount" class="form-control" @bind-Value="_payment.Amount" step="0.01" />
                <label for="paid-on">Payment date</label>
                <InputDate id="paid-on" class="form-control" @bind-Value="_payment.PaidOn" />
                <button type="submit" class="btn btn-primary mt-2">Save payment</button>
                <button type="button" class="btn btn-secondary mt-2" @onclick="Cancel">Cancel</button>
            </fieldset>
        </EditForm>
    }
    @if (_form is not null)
    {
        <h3>@(_editingId.HasValue ? "Correct drawdown" : "Record drawdown")</h3>
        @if (_editingId.HasValue)
        {
            <p>Saving a correction reverses the original drawdown and records this replacement.</p>
        }
        <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="drawdown">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@Busy">
                <label for="drawdown-amount">Amount (GBP)</label>
                <InputNumber id="drawdown-amount" class="form-control" @bind-Value="_form.Amount" step="0.01" />
                <label for="spent-on">Spending date</label>
                <InputDate id="spent-on" class="form-control" @bind-Value="_form.SpentOn" />
                <label for="drawdown-description">Description (optional, up to 200 characters)</label>
                <InputText id="drawdown-description" class="form-control" @bind-Value="_form.Description" maxlength="200" />
                <button type="submit" class="btn btn-primary mt-2">Save drawdown</button>
                <button type="button" class="btn btn-secondary mt-2" @onclick="Cancel">Cancel</button>
            </fieldset>
        </EditForm>
    }
    @if (_confirmation is not null)
    {
        <section class="alert alert-warning mt-3" aria-label="Confirm action">
            <p>@(_confirmation == "remove"
                ? "Mark this item removed? It will leave all budget sums, with its history retained read-only. This cannot be undone and does not record spending or update accounts."
                : "Reverse this entry? An offsetting reversal will be added to the history and the original stays visible. Account balances will not change.")</p>
            <button id="confirm-action" class="btn btn-danger" disabled="@Busy" @onclick="ConfirmAsync">Confirm</button>
            <button class="btn btn-secondary" disabled="@Busy" @onclick="Cancel">Cancel</button>
        </section>
    }
    <h3>History</h3>
    @if (_ledger.Entries.Length == 0)
    {
        <p>No entries recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead><tr><th>Date</th><th>Entry</th><th>Amount</th><th>Description</th><th>Recorded (UTC)</th><th>Status</th>@if (!item.IsRemoved) { <th>Actions</th> }</tr></thead>
                <tbody>
                    @foreach (var entry in _ledger.Entries)
                    {
                        <tr @key="entry.Id" class="ledger-entry">
                            <td>@entry.EffectiveDate.ToString("dd MMM yyyy")</td><td>@Display.LedgerEntryName(entry.Type)</td>
                            <td>@Display.Money(entry.Amount)</td><td>@entry.Description</td>
                            <td>@entry.RecordedAtUtc.ToString("dd MMM yyyy HH:mm:ss")</td>
                            <td>@Status(entry)</td>
                            @if (!item.IsRemoved)
                            {
                                <td>
                                    @if (entry.Type == LedgerEntryType.Drawdown && !entry.IsReversed)
                                    {
                                        <button class="btn btn-sm btn-outline-primary edit-drawdown" disabled="@(Locked)" @onclick="() => Edit(entry)">Correct</button>
                                    }
                                    @if (entry.Type != LedgerEntryType.Reversal && !entry.IsReversed)
                                    {
                                        <button class="btn btn-sm btn-outline-danger reverse-entry" disabled="@(Locked)" @onclick="() => ConfirmReversal(entry.Id)">Reverse</button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <p>@(Busy ? "Loading item..." : "Item has not loaded. Retry with Refresh item.")</p>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private SavingsLedgerResponse? _ledger;
    private SaveDrawdownRequest? _form;
    private RecordPaymentRequest? _payment;
    private Guid? _editingId;
    private string? _confirmation;
    private Guid _reversingId;

    private bool Locked => Busy || _form is not null || _payment is not null || _confirmation is not null;

    protected override Task OnParametersSetAsync() => LoadAsync();
    private async Task LoadAsync() => await PerformAsync(async () => _ledger = await Api.GetLedgerAsync(Id));

    private static string Status(LedgerEntryResponse entry) => string.Join("; ", new[]
    {
        entry.IsReversed ? "Reversed" : null,
        entry.ReversesEntryId.HasValue ? "Reverses an earlier entry" : null,
        entry.ReplacesEntryId.HasValue ? "Correction" : null,
        entry.IsInferred ? "Inferred from earlier totals" : null
    }.Where(x => x is not null));

    private void StartPayment()
    {
        if (_ledger is null || Busy) return;
        ClearError();
        _payment = new() { PaidOn = _ledger.AsOfDate, Version = _ledger.Item.Version };
    }

    private void Edit(LedgerEntryResponse? record)
    {
        if (_ledger is null || Busy) return;
        ClearError();
        _editingId = record?.Id;
        _form = new()
        {
            Amount = record?.Amount ?? _ledger.Item.AvailableAmount,
            SpentOn = record?.EffectiveDate ?? _ledger.AsOfDate, Description = record?.Description,
            Version = _ledger.Item.Version
        };
    }

    private void Cancel()
    {
        if (Busy) return;
        _form = null;
        _payment = null;
        _confirmation = null;
        ClearError();
    }

    private void ConfirmRemoval()
    {
        ClearError();
        _confirmation = "remove";
    }

    private void ConfirmReversal(Guid id)
    {
        ClearError();
        _reversingId = id;
        _confirmation = "reverse";
    }

    private async Task SavePaymentAsync()
    {
        if (_payment is null) return;
        if (await PerformAsync(async () => await Api.RecordPaymentAsync(Id, _payment)))
        {
            _payment = null;
            await LoadAsync();
        }
    }

    private async Task SaveAsync()
    {
        if (_form is null) return;
        if (await PerformAsync(async () => await Api.SaveDrawdownAsync(Id, _editingId, _form)))
        {
            _form = null;
            await LoadAsync();
        }
    }

    private async Task ConfirmAsync()
    {
        if (_ledger is null || _confirmation is null) return;
        var request = new ItemVersionRequest { Version = _ledger.Item.Version };
        if (await PerformAsync(async () =>
        {
            if (_confirmation == "remove") await Api.RemoveItemAsync(Id, request);
            else await Api.ReverseEntryAsync(Id, _reversingId, request);
        }))
        {
            _confirmation = null;
            await LoadAsync();
        }
    }
}
